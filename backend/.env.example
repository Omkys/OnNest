PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/onnests
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Keep SMTP secrets in backend/.env only — never commit or expose to the frontend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
