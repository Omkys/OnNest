{
  "name": "onnests",
  "version": "1.0.0",
  "private": true,
  "description": "OnNests multi-tenant property operations platform",
  "scripts": {
    "dev:api": "npm run dev --prefix backend",
    "dev:web": "npm run dev --prefix frontend",
    "dev": "npm run dev:api",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "docker:up": "docker compose up -d mongodb redis",
    "docker:down": "docker compose down"
  }
}
